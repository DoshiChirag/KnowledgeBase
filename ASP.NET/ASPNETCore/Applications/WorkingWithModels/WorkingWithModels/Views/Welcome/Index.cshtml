@{
    ViewData["Title"] = "Welcome";
    MockData data = ViewData.Model as MockData;
}

<h2>@ViewData["Title"]</h2>
<ul>
    @{
                 
        for (int i = 0; i < data.GetNumTimes(); i++)
        {
        
            <li>@data.GetName()</li>
        }
    }
</ul>