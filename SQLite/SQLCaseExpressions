SELECT year, month, 
SUM(precipitation) AS tornado_precipitation
FROM station_data

WHERE tornado = 1
AND year >= 1990

GROUP BY year,month;


SELECT year, month, 
SUM(CASE WHEN tornado = 1 THEN precipitation ELSE NULL END) AS tornado_precipitation,
SUM(CASE WHEN tornado = 0 THEN precipitation ELSE NULL END) AS non_tornado_precipitation
FROM station_data

WHERE year >= 1990

GROUP BY year,month;
